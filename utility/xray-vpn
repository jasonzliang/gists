      [ "$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | awk 'NR>1' | wc -l | tr -d ' ')" -ge 1 ] && ok "listening on port $PORT" || bad "nothing listening on $PORT (xray-vpn server on)"
