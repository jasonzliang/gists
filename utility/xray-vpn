cfd_stop(){ if cfd_loaded; then launchctl bootout "gui/$UID_/$CFD_LABEL" 2>/dev/null; for _ in $(seq 1 25); do cfd_loaded || break; sleep 0.2; done; fi; }
cf_apply(){ # tunnel exists, ingress + DNS match config.toml, connector running
