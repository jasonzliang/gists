  mkdir -p "$(dirname "$CFD_PLIST")"; mv "$T" "$CFD_PLIST"; chmod 600 "$CFD_PLIST"; cfd_stop
  launchctl bootstrap "gui/$UID_" "$CFD_PLIST" 2>/dev/null && ok "cloudflared connector started" || { bad "could not start cloudflared (launchd refused)"; return 1; }; }
# --- DDNS for the optional direct path ([server] host)
ddns(){ # [--force]
  [ "$DIRECT" = true ] || return 0
  [ -n "$CF_API" ] || { echo "ddns: no [cloudflare] api_token"; return 1; }
  local IP z rec rid R; IP=$(curl -4 -s --max-time 10 https://checkip.amazonaws.com || curl -4 -s --max-time 10 https://api.ipify.org); IP=$(echo "$IP" | tr -d '[:space:]')
  echo "$IP" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || { echo "$(date -u +%FT%TZ) no public IP" >> "$DDNS_LOG"; return 1; }
  z=$(cf_zone "$HOST"); [ -n "$z" ] || { echo "$(date -u +%FT%TZ) CHECK FAILED: no zone for $HOST" >> "$DDNS_LOG"; return 1; }
  rec=$(cf_api "$CFB/zones/$z/dns_records?name=$HOST&type=A" | py 'r=d.get("result") or []; print(r[0]["id"]+" "+r[0]["content"] if r else "")'); rid="${rec%% *}"
  if [ -z "$rid" ]; then R=$(cf_api -X POST "$CFB/zones/$z/dns_records" --data "{\"type\":\"A\",\"name\":\"$HOST\",\"content\":\"$IP\",\"ttl\":120,\"proxied\":false}")
  elif [ "${rec#* }" = "$IP" ]; then [ "${1:-}" = "--force" ] && echo "$(date -u +%FT%TZ) unchanged $IP" >> "$DDNS_LOG"; return 0
  else R=$(cf_api -X PATCH "$CFB/zones/$z/dns_records/$rid" --data "{\"type\":\"A\",\"name\":\"$HOST\",\"content\":\"$IP\",\"ttl\":120,\"proxied\":false}"); fi
  if echo "$R" | grep -q '"success":true'; then echo "$(date -u +%FT%TZ) updated $HOST: ${rec#* } -> $IP" >> "$DDNS_LOG"; else echo "$(date -u +%FT%TZ) UPDATE FAILED: $(echo "$R" | cut -c1-200)" >> "$DDNS_LOG"; return 1; fi; }
ddns_agent_apply(){ # the 5-minute DDNS job exists only while the direct path is on
  local loaded=0; launchctl print "gui/$UID_/$DDNS_LABEL" >/dev/null 2>&1 && loaded=1
  if [ "$DIRECT" = true ]; then
    [ $loaded = 1 ] && grep -q 'xray-vpn' "$DDNS_PLIST" 2>/dev/null && return 0
    cat > "$DDNS_PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict><key>Label</key><string>$DDNS_LABEL</string>
  <key>ProgramArguments</key><array><string>$HOME/.local/bin/xray-vpn</string><string>server</string><string>ddns</string></array>
  <key>StartInterval</key><integer>300</integer><key>RunAtLoad</key><true/></dict></plist>
PL
    [ $loaded = 1 ] && launchctl bootout "gui/$UID_/$DDNS_LABEL" 2>/dev/null; launchctl bootstrap "gui/$UID_" "$DDNS_PLIST" 2>/dev/null && ok "ddns job every 5 min for $HOST"
  else [ $loaded = 1 ] && { launchctl bootout "gui/$UID_/$DDNS_LABEL" 2>/dev/null; rm -f "$DDNS_PLIST"; ok "ddns job removed (direct path off)"; }; fi; return 0; }
# --- self-tests
srv_selftest(){ # [cloudflare]  default: loopback Reality
  local T CP R P label tries=1 cfg; T=$(mktemp -d)
  if [ "${1:-}" = cloudflare ]; then
    cfg=$(printf '{"log":{"loglevel":"warning"},"inbounds":[{"listen":"127.0.0.1","port":10897,"protocol":"socks"}],"outbounds":[{"protocol":"vless","settings":{"vnext":[{"address":"%s","port":443,"users":[{"id":"%s","encryption":"none"}]}]},"streamSettings":{"network":"ws","security":"tls","tlsSettings":{"serverName":"%s","fingerprint":"%s"},"wsSettings":{"path":"%s","host":"%s"}}}]}' "$CFT_HOST" "$UUID" "$CFT_HOST" "$FP" "$CFT_PATH" "$CFT_HOST"); P=10897; label="cloudflare path (internet -> $CFT_HOST -> this Mac)"; tries=3
  else
