cf_zone(){ local h="$1" z; while [ "$(echo "$h" | tr -cd . | wc -c | tr -d ' ')" -ge 1 ]; do z=$(cf_api "$CFB/zones?name=$h" | py 'r=d.get("result") or []; print(r[0]["id"] if r else "")'); [ -n "$z" ] && { echo "$z"; return; }; h="${h#*.}"; done; }
cf_tunnel_id(){ cf_api "$CFB/accounts/$1/cfd_tunnel?name=$TUNNEL_NAME&is_deleted=false" | py 'r=d.get("result") or []; print(r[0]["id"] if r else "")'; }
