toml_edit(){ # toml_edit set SECTION KEY VALUE | toml_edit del SECTION KEY   (keeps comments; drops a section that becomes empty)
  python3 - "$CONF" "$@" <<'PY'
import sys,re
path,op,sec,key=sys.argv[1:5]; val=sys.argv[5] if len(sys.argv)>5 else None
L=open(path).read().split("\n")
start=None; end=len(L)
for i,l in enumerate(L):
    if re.match(r"\s*\[\s*%s\s*\]"%re.escape(sec), l): start=i
    elif start is not None and re.match(r"\s*\[", l): end=i; break
krx=re.compile(r'^(\s*%s\s*=\s*)("(?:[^"\\]|\\.)*"|[^#\s]+)(\s*#.*)?$'%re.escape(key))
if op=="set":
    if start is None:
        while L and not L[-1].strip(): L.pop()
        L += ["", "[%s]"%sec, "%s = %s"%(key,val)]
    else:
        for i in range(start+1,end):
            m=krx.match(L[i])
            if m: L[i]="%s%s%s"%(m.group(1),val,m.group(3) or ""); break
        else:
            j=end
            while j>start+1 and not L[j-1].strip(): j-=1
            L.insert(j, "%s = %s"%(key,val))
elif op=="del" and start is not None:
    L=[l for i,l in enumerate(L) if not (start<i<end and krx.match(l))]
    end2=len(L)
    for i in range(start+1,len(L)):
        if re.match(r"\s*\[", L[i]): end2=i; break
    if not any(re.match(r"\s*[A-Za-z0-9_]+\s*=", l) for l in L[start+1:end2]):
        del L[start:end2]
        while 0<start<len(L) and not L[start].strip() and not L[start-1].strip(): del L[start]
open(path,"w").write("\n".join(L).rstrip("\n")+"\n")
PY
}
srv_apply(){ srv_write_config; case $? in 0) ok "server config regenerated from $CONF (backup: config.json.bak)";; 1) ok "server config already matches $CONF";; esac
