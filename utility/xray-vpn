        [ "$(lsof -nP -iTCP:"$CFT_LOCAL" -sTCP:LISTEN 2>/dev/null | awk 'NR>1' | wc -l | tr -d ' ')" -ge 1 ] && ok "cloudflare inbound listening on 127.0.0.1:$CFT_LOCAL" || bad "nothing listening on 127.0.0.1:$CFT_LOCAL"
