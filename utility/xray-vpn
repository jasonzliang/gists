        lan)        addr=$LAN_HOST; port=$LAN_PORT; kind=reality; where="home LAN $LAN_HOST:$LAN_PORT" ;;
        direct)     addr=$HOST; port=$PUBLIC_PORT; kind=reality; where="direct $HOST:$PUBLIC_PORT" ;;
        cloudflare) addr=$CFT_HOST; port=443; kind=ws; where="Cloudflare Tunnel $CFT_HOST:443" ;;
      esac
      if start_client "$addr" "$port" "$kind" "$where"; then got=1; break; fi
    done
    if [ $got = 1 ]; then
      if proxy_on; then ok "all apps now go through the tunnel"; else bad "could not set the system proxy (apps stay direct; SOCKS5 127.0.0.1:$SOCKS_PORT still works)"; fi
      echo "xray-vpn: CONNECTED   (to disconnect, run: xray-vpn off)"
    else proxy_off; echo "xray-vpn: NOT connected (tried:$(for p in $paths; do printf ' %s' "$p"; done)).  Check the server with: xray-vpn server"; exit 1; fi ;;
  off)
    lock; proxy_off && ok "apps back to direct"
    if is_loaded; then stop_client; ok "tunnel stopped"; fi
    rm -f "$PLIST" "$STATE" "$CLIENT"; echo "xray-vpn: OFF" ;;
  status) client_status; server_block ;;
  test)
    connected || die "not connected. First:  xray-vpn on"
    d=$(curl -4 -s --max-time 8 https://api.ipify.org); t=$(exit_ip 20)
    [ -n "$t" ] && ok "exit IP via tunnel $t (direct: ${d:-none}$([ "$t" = "$d" ] && echo ', same because you are at home'))" || bad "no reply through the tunnel"
    for h in example.com zoom.us; do c=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 --socks5-hostname "127.0.0.1:$SOCKS_PORT" "https://$h/"); case "$c" in 2*|3*) ok "https://$h -> $c";; *) bad "https://$h -> ${c:-no response}";; esac; done
    bps=$(curl -o /dev/null -s -w '%{speed_download}' --max-time 60 --socks5-hostname "127.0.0.1:$SOCKS_PORT" 'https://speed.cloudflare.com/__down?bytes=20000000'); ok "download via tunnel $(awk -v b="${bps:-0}" 'BEGIN{printf "%.1f Mbit/s", b*8/1e6}')"
    if is_server; then last=$(tail -1 "$SRV_ALOG" 2>/dev/null | cut -c1-100); else last=$(ssh -o BatchMode=yes -o ConnectTimeout=6 "$SERVER_SSH" "tail -1 $SRV_ALOG" 2>/dev/null | cut -c1-100); fi
    [ -n "$last" ] && ok "server saw: $last" || info "server log not readable from here (normal when away from home)"
    if proxy_is_on; then ok "all apps routed through the tunnel"; else info "apps are NOT routed (to route them, run: xray-vpn proxy on)"; fi
    exit $FAILED ;;
  proxy) lock; case "${1:-}" in on) connected || die "not connected. First:  xray-vpn on"; proxy_on && ok "all apps now go through the tunnel";; off) proxy_off; ok "apps back to direct";; *) proxy_is_on && echo "apps: through the tunnel" || echo "apps: direct";; esac ;;
  log)    tail -n "${1:-30}" "$LOG" 2>/dev/null || echo "no client log yet" ;;
  link)   [ "$CFT" = true ] && { echo "cloudflare (primary, no router needed):"; link_cloudflare; echo; }
          [ "$DIRECT" = true ] && { echo "direct (needs the router forward):"; link_direct; }; true ;;
  qr)     L=$(link_pick "${1:-}") || exit 1; [ -n "$L" ] || exit 1; if command -v qrencode >/dev/null; then echo "$L" | qrencode -t ANSIUTF8; else echo "(brew install qrencode  for a QR code)"; fi; echo; echo "link (treat like a password):"; echo "$L" ;;
  sync)   sync_conf ;;
  server) server "$@" ;;
  install) install_deps "${1:-client}" ;;
  _client_toml) client_toml ;;
  help|-h|--help) if [ "${1:-}" = more ]; then awk 'NR>1 && !/^#/{exit} NR>1 && !/^# ---/{sub(/^# ?/,""); print}' "$0"
                  else awk 'NR>1 && (!/^#/ || /^# ---/){exit} NR>1{sub(/^# ?/,""); print}' "$0"; fi ;;
  *) die "unknown command '$cmd'   (xray-vpn help)" ;;
esac
