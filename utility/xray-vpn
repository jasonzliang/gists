path_switch(){ # $1 cloudflare|direct  $2 on|off  [$3 host]
  case "$1:$2" in
    cloudflare:on)  [ -n "$CFT_HOST" ] || die "no [cloudflare] hostname in $CONF yet; add it once (hostname = \"tun.rome-ai.space\")"; toml_edit del cloudflare enabled ;;
    cloudflare:off) toml_edit set cloudflare enabled false ;;
    direct:on)      [ -n "${3:-}" ] || [ -n "$HOST" ] || die "usage: xray-vpn server direct on <public-dns-name>   (e.g. home.rome-ai.space; needs the router to forward 443 -> this Mac:$PORT)"
                    [ -n "${3:-}" ] && toml_edit set server host "\"$3\""; toml_edit del server direct ;;
    direct:off)     toml_edit del server host; toml_edit del server direct ;;
    *) die "usage: xray-vpn server cloudflare on|off   or   xray-vpn server direct on <host>|off" ;;
