cf_api(){ curl -s --max-time 20 -H "Authorization: Bearer $CF_API" -H "Content-Type: application/json" "$@"; }
cf_account(){ # the token may not be allowed to list accounts; the zone of the hostname also carries the account id
  local a h; a=$(cf_api "$CFB/accounts?per_page=1" | py 'r=d.get("result") or []; print(r[0]["id"] if r else "")'); [ -n "$a" ] && { echo "$a"; return; }
